# ==============================================================================
# MANISHA ELECTRONICS - ROOT / DOCKER ENVIRONMENT CONFIGURATION
# Copy this file to '.env' for local Docker Compose or cloud production setup.
# WARNING: NEVER commit your actual '.env' or secret production credentials to Git!
# ==============================================================================

# --- Database Configuration ---
# Local Docker MySQL: jdbc:mysql://db:3306/stockmanagement?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Kolkata
# Cloud MySQL (TiDB / Aiven): jdbc:mysql://your-cluster-host:4000/test?sslMode=VERIFY_IDENTITY&enabledTLSProtocols=TLSv1.2,TLSv1.3
DB_URL=jdbc:mysql://localhost:3306/stockmanagement?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Kolkata
DB_USERNAME=root
DB_PASSWORD=your_secure_database_password
DB_DRIVER=com.mysql.cj.jdbc.Driver
SHOW_SQL=false

# --- Server Port ---
PORT=8080

# --- Security: JWT Authentication ---
# Secret must be at least 256 bits (32+ characters) for HMAC-SHA256
JWT_SECRET=ReplaceWithYourSecureRandom64CharSecretKeyForTokenSigning2026!
JWT_EXPIRY_DAYS=30

# --- Admin Master Credentials ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_admin_password
ADMIN_PIN=1234

# --- Retail Store Profile (Defaults) ---
SHOP_NAME=MANISHA ELECTRONICS
SHOP_ADDRESS=EDEN GROVE Building, Nr. State Bank of India, Valpoi, Goa
SHOP_PHONE=9309736172
SHOP_GSTIN=30AMYPN1753F1ZY
