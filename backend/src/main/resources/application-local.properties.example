# Local Development Configuration Template
# Copy this file to 'application-local.properties' and fill in your local credentials.
# NOTE: 'application-local.properties' is ignored by Git and must NEVER be committed.

# Database Configuration (Local MySQL or your Dev Database)
spring.datasource.url=jdbc:mysql://localhost:3306/stockmanagement?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
spring.datasource.username=root
spring.datasource.password=your_local_db_password

# Security & Authentication Configuration
# JWT secret must be at least 256 bits (32+ characters) for HMAC-SHA256
auth.jwt.secret=LocalDevSecretKeyReplaceWithSecureRandomStringForTestingOnlyAtLeast256Bits
auth.admin.username=Admin
auth.admin.password=change_me_locally
auth.admin.pin=0000

# Shop Profile (Local Defaults)
shop.name=MANISHA ELECTRONICS (Local Dev)
shop.address=Local Development Store Address
shop.phone=9309736172
shop.gstin=30AAAAA0000A1Z5
